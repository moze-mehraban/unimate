# Copy to .env. Expo inlines EXPO_PUBLIC_* at build time (they're public values).
#
# Local Supabase: on a real phone 127.0.0.1 is the phone itself, so use your
# computer's LAN IP (e.g. http://192.168.1.10:54321). Android emulator: http://10.0.2.2:54321.
# Or point at the cloud project: https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The web app, where password-reset links finish.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
