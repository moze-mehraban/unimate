# Copy to .env.local. Values for local dev are printed by `npx supabase start`
# (API URL and Publishable key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: fixed public origin for auth redirect links (e.g. https://unimate.app).
# NEXT_PUBLIC_SITE_URL=
