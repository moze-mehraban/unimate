# Copy to .env (never commit .env).
# Google OAuth client for Supabase Auth (Google Cloud Console → Credentials).
# Authorized redirect URI for local dev: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
http://127.0.0.1:54321/auth/v1/callback flowName=GeneralOAuthFlow